{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun scripts/build-banner.mjs",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    { "source": "/banner.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
