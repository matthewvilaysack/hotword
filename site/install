#!/bin/sh
# hotword installer: curl -fsSL https://hotword-dusky.vercel.app/install | sh
#
# Picks the release tarball for this machine, checks it against the SHA256SUMS
# that release published, and puts the binary in ~/.local/bin (or $PREFIX).
# No sudo, nothing written outside that directory. Options:
#   --version X.Y.Z   install that release instead of the newest
#   --prefix DIR      install into DIR instead of ~/.local/bin
#   --dry-run         show what would happen and stop
set -eu

repo="matthewvilaysack/hotword"
version=""
prefix="${PREFIX:-$HOME/.local/bin}"
dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --version) version="$2"; shift 2 ;;
    --version=*) version="${1#--version=}"; shift ;;
    --prefix) prefix="$2"; shift 2 ;;
    --prefix=*) prefix="${1#--prefix=}"; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,10p' "$0" 2>/dev/null || true; exit 0 ;;
    *) echo "install: unknown option $1" >&2; exit 2 ;;
  esac
done

say() { printf '%s\n' "$*" >&2; }
die() { say "install: $*"; exit 1; }

os=$(uname -s); arch=$(uname -m)
case "$os" in
  Darwin) os_part="apple-darwin" ;;
  Linux) os_part="unknown-linux-gnu" ;;
  *) die "no build for $os; build from source with cargo install --git https://github.com/$repo" ;;
esac
case "$arch" in
  arm64|aarch64) arch_part="aarch64" ;;
  x86_64|amd64) arch_part="x86_64" ;;
  *) die "no build for $arch; build from source with cargo install --git https://github.com/$repo" ;;
esac
target="$arch_part-$os_part"

if [ -z "$version" ]; then
  version=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -1)
  [ -n "$version" ] || die "could not find the latest release"
fi
version="${version#v}"
name="hotword-$version-$target"
base="https://github.com/$repo/releases/download/v$version"

say "hotword $version for $target"
say "into $prefix"
[ "$dry" -eq 1 ] && { say "dry run, stopping here"; exit 0; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl -fsSL "$base/$name.tar.gz" -o "$work/$name.tar.gz" || die "download failed: $base/$name.tar.gz"
curl -fsSL "$base/SHA256SUMS" -o "$work/SHA256SUMS" || die "download failed: $base/SHA256SUMS"

expected=$(grep " $name.tar.gz\$" "$work/SHA256SUMS" | cut -d' ' -f1)
[ -n "$expected" ] || die "SHA256SUMS has no entry for $name.tar.gz"
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$work/$name.tar.gz" | cut -d' ' -f1)
else
  actual=$(shasum -a 256 "$work/$name.tar.gz" | cut -d' ' -f1)
fi
[ "$actual" = "$expected" ] || die "checksum mismatch for $name.tar.gz (expected $expected, got $actual)"

tar xzf "$work/$name.tar.gz" -C "$work"
mkdir -p "$prefix"
install -m 755 "$work/$name/hotword" "$prefix/hotword"
say "installed $prefix/hotword ($("$prefix/hotword" --version))"
case ":$PATH:" in
  *":$prefix:"*) ;;
  *) say "note: $prefix is not on your PATH; add it to your shell profile" ;;
esac
say "next: hotword install   (registers the agent hooks)"
